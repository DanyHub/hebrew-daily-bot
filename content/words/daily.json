  "sentences": [
    {"level": 1, "he": "שלום, תודה ובבקשה.", "translit": {"fr": "Chalom, toda ouvévakacha.", "en": "Shalom, toda uvevakasha."}, "translation": {"fr": "Bonjour, merci et de rien.", "en": "Hello, thank you and you're welcome."}},
    {"level": 1, "he": "סליחה, אולי אתה יודע איפה התחנה?", "translit": {"fr": "Slih'a, oulaï ata yoda éfo hatah'ana?", "en": "Slicha, ulai ata yode'a eifo hatachana?"}, "translation": {"fr": "Pardon, tu sais peut-être où est la station ?", "en": "Excuse me, maybe you know where the station is?"}},
    {"level": 1, "he": "כן, בטח, זה בסדר.", "translit": {"fr": "Kène, bétah', zé békhèdèr.", "en": "Ken, betach, ze beseder."}, "translation": {"fr": "Oui, bien sûr, ça va.", "en": "Yes, of course, it's fine."}},
    {"level": 1, "he": "לא, תודה. להתראות!", "translit": {"fr": "Lo, toda. Lèhitra'ot!", "en": "Lo, toda. Lehitra'ot!"}, "translation": {"fr": "Non, merci. Au revoir !", "en": "No, thanks. Goodbye!"}},
    {"level": 2, "he": "אחרי המבחן הוא היה מבולבל והמום.", "translit": {"fr": "Ah'aré hamivh'ane hou haya mévoulbal vèhamoum.", "en": "Acharei hamivchan hu haya mevulbal vehamum."}, "translation": {"fr": "Après l'examen il était confus et abasourdi.", "en": "After the exam he was confused and stunned."}},
    {"level": 2, "he": "אני מתוסכל כי המחשב לא עובד.", "translit": {"fr": "Ani métouskal ki hamakhchev lo ové'd.", "en": "Ani mesukhal ki hamachshev lo oved."}, "translation": {"fr": "Je suis frustré parce que l'ordinateur ne marche pas.", "en": "I'm frustrated because the computer doesn't work."}},
    {"level": 2, "he": "הוא נודניק, הוא שואל אותה שאלה סתם ככה.", "translit": {"fr": "Hou noudnik, hou choèl ota chééla stam kakha.", "en": "Hu nudnik, hu shoel ota she'ela stam kacha."}, "translation": {"fr": "C'est un casse-pieds, il pose la même question sans raison.", "en": "He's a pest, he asks the same question for no reason."}},
    {"level": 2, "he": "העבודה חפיפה, וזה מעצבן ומוזר.", "translit": {"fr": "Ha'avoda h'afifa, vèzé méatsbène oumouzar.", "en": "Ha'avoda chafifa, veze me'atzben umuzar."}, "translation": {"fr": "Le travail est bâclé, c'est énervant et bizarre.", "en": "The work is sloppy, which is annoying and strange."}}
  ]
