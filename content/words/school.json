    {"id": "school-20", "level": 2, "he": "ספרייה", "pos": "nf", "translit": {"fr": "sifriya", "en": "sifriya"}, "meaning": {"fr": "Bibliothèque", "en": "Library"}}
  ],
  "sentences": [
    {"level": 1, "he": "המורה כותבת על הלוח.", "translit": {"fr": "Hamoré kotévèt al haloua'h.", "en": "Hamora kotevet al haluach."}, "translation": {"fr": "La professeure écrit au tableau.", "en": "The teacher writes on the board."}},
    {"level": 1, "he": "התלמיד פותח את הספר והמחברת.", "translit": {"fr": "Hatalmid poté'ah' èt hasséfère vèhamah'bérète.", "en": "Hatalmid potei'ach et hasefer vehamachberet."}, "translation": {"fr": "L'élève ouvre le livre et le cahier.", "en": "The student opens the book and the notebook."}},
    {"level": 1, "he": "בכיתה שלנו יש שיעור ציור.", "translit": {"fr": "Bakita chélanou yèch chi'our tsiour.", "en": "Bakita shelanu yesh shi'ur tziyur."}, "translation": {"fr": "Dans notre classe il y a un cours de dessin.", "en": "In our class there is a drawing lesson."}},
    {"level": 1, "he": "אני שם עט בתיק ויוצא.", "translit": {"fr": "Ani sam èt batik vèyotsé.", "en": "Ani sam et batik veyotze."}, "translation": {"fr": "Je mets un stylo dans mon cartable et je sors.", "en": "I put a pen in my bag and leave."}},
    {"level": 2, "he": "יש לי מבחן מחר ועוד לא עשיתי שיעורי בית.", "translit": {"fr": "Yèch li mivh'ane mah'ar vè'od lo assiti chi'oure bayit.", "en": "Yesh li mivchan machar ve'od lo asiti shiurei bayit."}, "translation": {"fr": "J'ai un examen demain et je n'ai pas encore fait mes devoirs.", "en": "I have an exam tomorrow and I haven't done my homework yet."}},
    {"level": 2, "he": "הציון שלי בתעודה השתפר השנה.", "translit": {"fr": "Hatsioune chéli bate'ouda hichtapère hachana.", "en": "Hatziyun sheli bete'uda hishtaper hashana."}, "translation": {"fr": "Ma note sur le bulletin s'est améliorée cette année.", "en": "My grade on the report improved this year."}},
    {"level": 2, "he": "בהפסקה הסטודנט הלך לספרייה עם המילון.", "translit": {"fr": "Bahafsaka hastoudènt halakh lassifriya im hamilone.", "en": "Bahafsaka hastudent halach lasifriya im hamilon."}, "translation": {"fr": "À la pause l'étudiant est allé à la bibliothèque avec le dictionnaire.", "en": "At the break the student went to the library with the dictionary."}},
    {"level": 2, "he": "המנהל נאם באוניברסיטה בטקס.", "translit": {"fr": "Hamenahel naham bèounivérsita batèkèss.", "en": "Hamenahel naam ba'universita batekes."}, "translation": {"fr": "Le directeur a prononcé un discours à l'université lors de la cérémonie.", "en": "The principal gave a speech at the university at the ceremony."}}
  ]
}
