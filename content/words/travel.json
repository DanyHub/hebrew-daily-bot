    {"id": "travel-20", "level": 2, "he": "פיצוי", "pos": "nm", "translit": {"fr": "pitsouy", "en": "pitzuy"}, "meaning": {"fr": "Indemnisation", "en": "Compensation"}}
  ],
  "sentences": [
    {"level": 1, "he": "אנחנו נוסעים לחופשה בים.", "translit": {"fr": "Anah'nou nos'im lèh'ouchha bayam.", "en": "Anachnu nos'im lechufsha bayam."}, "translation": {"fr": "Nous partons en vacances à la mer.", "en": "We are going on vacation by the sea."}},
    {"level": 1, "he": "הכרטיס והדרכון בתיק שלי.", "translit": {"fr": "Hakartiss vèhadarkone batik chéli.", "en": "Hakartis vehadarkon batik sheli."}, "translation": {"fr": "Le billet et le passeport sont dans mon sac.", "en": "The ticket and the passport are in my bag."}},
    {"level": 1, "he": "המטוס נוחת בשדה התעופה בערב.", "translit": {"fr": "Hamatos nouh'ète bèssdé hate'oufa baérèv.", "en": "Hamatos nocheet besde hate'ufa ba'erev."}, "translation": {"fr": "L'avion atterrit à l'aéroport le soir.", "en": "The plane lands at the airport in the evening."}},
    {"level": 1, "he": "במלון יש חוף יפה, וגם מפה של העיר.", "translit": {"fr": "Bamalone yèch h'of yafé, vègam mapa chèl haïr.", "en": "Bamalon yesh chof yafe, vegam mapa shel ha'ir."}, "translation": {"fr": "À l'hôtel il y a une belle plage et aussi une carte de la ville.", "en": "At the hotel there is a lovely beach, and also a map of the city."}},
    {"level": 2, "he": "הטיסה התעכבה והנוסעים חיכו שעתיים.", "translit": {"fr": "Hatissa hit'akhva vèhanos'im h'ikou cha'atayim.", "en": "Hatisa hitakeva vehanos'im chiku sha'atayim."}, "translation": {"fr": "Le vol a pris du retard et les passagers ont attendu deux heures.", "en": "The flight was delayed and the passengers waited two hours."}},
    {"level": 2, "he": "ביצענו הזמנה ליעד שקיבלנו מהמדריך.", "translit": {"fr": "Bitsa'nou hazmana lèya'ad chèkibalnou mèhamadrikh.", "en": "Bitza'nu hazmana leya'ad shekibalnu mehamadrich."}, "translation": {"fr": "Nous avons réservé pour la destination que le guide nous a indiquée.", "en": "We made a reservation for the destination the guide gave us."}},
    {"level": 2, "he": "המזוודות הלכו לאיבוד ודרשנו פיצוי.", "translit": {"fr": "Hamizvadot halkhou lé'ivoud vèdarachnou pitsouy.", "en": "Hamizvadot halchu le'ibud vedarashnu pitzuy."}, "translation": {"fr": "Les bagages ont été perdus et nous avons exigé une indemnisation.", "en": "The luggage got lost and we demanded compensation."}},
    {"level": 2, "he": "בלי ויזה אי אפשר לעלות על המסלול הזה.", "translit": {"fr": "Bli viza é éfchar la'alot al hamassloul hazé.", "en": "Bli viza ei efshar la'alot al hamaslul haze."}, "translation": {"fr": "Sans visa, on ne peut pas emprunter cet itinéraire.", "en": "Without a visa you can't take this route."}}
  ]
}
