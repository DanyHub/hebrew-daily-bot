  "sentences": [
    {"level": 1, "he": "שלחתי לך הודעה עם תמונה.", "translit": {"fr": "Chalah'ti lèkha hoda'a im tmouna.", "en": "Shalachti lecha hoda'a im tmuna."}, "translation": {"fr": "Je t'ai envoyé un message avec une photo.", "en": "I sent you a message with a picture."}},
    {"level": 1, "he": "הילד מסתכל על סרטון במסך.", "translit": {"fr": "Hayéled missta'kèl al sartone bamassakh.", "en": "Hayeled mistakel al sarton bamasach."}, "translation": {"fr": "L'enfant regarde une vidéo sur l'écran.", "en": "The child watches a video on the screen."}},
    {"level": 1, "he": "שכחתי את הסיסמה של האפליקציה.", "translit": {"fr": "Chakhah'ti èt hassismah chèl haaplikatsya.", "en": "Shachachti et hasisma shel ha'aplikatzya."}, "translation": {"fr": "J'ai oublié le mot de passe de l'application.", "en": "I forgot the app's password."}},
    {"level": 1, "he": "יש מקלדת חדשה ליד המחשב.", "translit": {"fr": "Yèch miklèdèt h'adacha léyad hamakhchev.", "en": "Yesh mikledet chadasha leyad hamachshev."}, "translation": {"fr": "Il y a un nouveau clavier à côté de l'ordinateur.", "en": "There's a new keyboard next to the computer."}},
    {"level": 2, "he": "הסוללה התרוקנה ואין לי מטען.", "translit": {"fr": "Hassoula hitrokna vèèïne li mat'èn.", "en": "Hasolela hitrokna ve'ein li mat'en."}, "translation": {"fr": "La batterie s'est vidée et je n'ai pas de chargeur.", "en": "The battery died and I don't have a charger."}},
    {"level": 2, "he": "הורדתי קובץ ושמתי עדכון בתוכנה.", "translit": {"fr": "Horadti kovèts vèsamti ikoune batokhna.", "en": "Horadti kovetz vesamti ikun batochna."}, "translation": {"fr": "J'ai téléchargé un fichier et fait une mise à jour du logiciel.", "en": "I downloaded a file and updated the software."}},
    {"level": 2, "he": "השרת נפל והרשת לא עבדה כל הבוקר.", "translit": {"fr": "Hassartè nafal vèharéchèt lo avda kol haboker.", "en": "Hasharet nafal vehareshet lo avda kol haboker."}, "translation": {"fr": "Le serveur est tombé et le réseau n'a pas marché toute la matinée.", "en": "The server went down and the network didn't work all morning."}},
    {"level": 2, "he": "הפרטיות שלי חשובה לי, אז אני מחליף סיסמה בכל התחברות חשודה.", "translit": {"fr": "Hapratiyout chéli h'achouva li, az ani mah'liph' sismah bèkhol hitkhabrout h'achouda.", "en": "Hapratiyut sheli chashuva li, az ani machlif sisma bechol hitchabrut chashuda."}, "translation": {"fr": "Ma vie privée est importante pour moi, donc je change de mot de passe.", "en": "My privacy matters to me, so I change my password."}}
  ]
