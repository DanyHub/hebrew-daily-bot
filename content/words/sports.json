  "sentences": [
    {"level": 1, "he": "הילדים משחקים כדורגל במגרש.", "translit": {"fr": "Hayéladim missah'akim kadourègèl bamigrach.", "en": "Hayeladim mesachakim kaduregel bamigrash."}, "translation": {"fr": "Les enfants jouent au football sur le terrain.", "en": "The kids play soccer on the field."}},
    {"level": 1, "he": "השחקן זורק את הכדור לקבוצה.", "translit": {"fr": "Hasah'akane zorèk èt hakadour lakvoutsa.", "en": "Hasachkan zorek et hakadur lakvutza."}, "translation": {"fr": "Le joueur lance le ballon à l'équipe.", "en": "The player throws the ball to the team."}},
    {"level": 1, "he": "אני אוהב שחייה וריצה.", "translit": {"fr": "Ani ohèv s'h'iya vèritsa.", "en": "Ani ohev schiya veritza."}, "translation": {"fr": "J'aime la natation et la course.", "en": "I like swimming and running."}},
    {"level": 1, "he": "יש לנו אימון כדורסל ביום שלישי.", "translit": {"fr": "Yèch lanou imoune kadoursal bayom chlichi.", "en": "Yesh lanu imun kadursal beyom shlishi."}, "translation": {"fr": "Nous avons entraînement de basket le mardi.", "en": "We have basketball training on Tuesday."}},
    {"level": 2, "he": "הקבוצה שלנו זכתה בניצחון גדול באליפות.", "translit": {"fr": "Hakvoutsa chélanou zakhta binitsah'one gadol baalifout.", "en": "Hakvutza shelanu zachta benitzachon gadol ba'alifut."}, "translation": {"fr": "Notre équipe a remporté une grande victoire au championnat.", "en": "Our team won a big victory in the championship."}},
    {"level": 2, "he": "השופט שרק תיקו והאוהדים צעקו.", "translit": {"fr": "Hachofèt charak tèkou vèha'ohadim tsa'aqou.", "en": "Hashofet sharak teku vehohadim tza'aku."}, "translation": {"fr": "L'arbitre a sifflé match nul et les supporters ont crié.", "en": "The referee whistled a draw and the fans shouted."}},
    {"level": 2, "he": "השוער הציל כדור והמאמן חיבק אותו.", "translit": {"fr": "Hachove'r hitsil kadour vèhamèamèn h'ibèk oto.", "en": "Hashoer hitzil kadur vehame'amen chibek oto."}, "translation": {"fr": "Le gardien a arrêté un tir et l'entraîneur l'a serré dans ses bras.", "en": "The goalkeeper saved a shot and the coach hugged him."}},
    {"level": 2, "he": "אחרי הפסד כואב הוא שבר שיא בתחרות הבאה.", "translit": {"fr": "Ah'aré hèfsèd koév hou chavar si batah'arout haba'a.", "en": "Acharei hefsed ko'ev hu shavar si bataccharut haba'a."}, "translation": {"fr": "Après une défaite douloureuse il a battu un record à la compétition suivante.", "en": "After a painful loss he broke a record in the next competition."}}
  ]
}
